<nav class="sticky top-0 z-10 border-b border-line bg-paper">
  <div class="mx-auto flex max-w-[1088px] items-center gap-3.5 px-5 py-[15px] sm:px-10">
    <a href="#top" class="flex items-center gap-2 text-ink">
      <span class="inline-block size-6 rounded-full bg-ember"></span>
      <span class="font-serif text-[17px] font-semibold">PhxIcons</span>
    </a>
    <span class="ml-auto rounded-md border border-line bg-white px-2 py-1 font-mono text-xs font-medium text-muted">
      v{phx_icons_version()}
    </span>
    <a
      href="https://github.com/ream88/phx_icons"
      class="flex items-center gap-1 text-[13px] font-medium text-ink"
    >
      GitHub <.icon name="lucide:arrow-up-right" class="size-3" />
    </a>
  </div>
</nav>

<div id="top" class="mx-auto flex max-w-[1088px] gap-12 px-5 pt-11 sm:px-10">
  <main class="min-w-0 flex-1 lg:max-w-[760px]">
    <div class="mb-3 text-xs font-semibold tracking-[.1em] text-ember uppercase">
      Phoenix LiveView library
    </div>
    <h1 class="mb-3.5 font-serif text-[42px] leading-[1.1] font-semibold tracking-[-.01em] text-pretty">
      One component.<br />Seven+ icon libraries.
    </h1>
    <p class="mb-6 text-base leading-[1.65] text-body text-pretty">
      Icon library for Phoenix LiveView that scans your templates at compile time, downloads only
      the icons you actually use, and inlines the SVGs as compiled function clauses. Zero runtime
      overhead, no unused icons bundled, no Node.js required.
    </p>
    <div class="mb-8 flex flex-wrap gap-2.5">
      <button
        type="button"
        data-copy={~s({:phx_icons, "~> #{phx_icons_version()}"})}
        class="flex h-11 cursor-pointer items-center gap-2.5 rounded-lg border border-line bg-white px-4 font-mono text-[13px] font-medium text-body hover:border-ember"
      >
        {~s({:phx_icons, "~> #{phx_icons_version()}"})}
        <.icon name="lucide:copy" class="size-3.5 text-faint" />
      </button>
    </div>

    <h2 id="install" class="mb-1.5 scroll-mt-20 font-serif text-[26px] font-semibold">
      Installation
    </h2>
    <p class="mb-4 text-[14.5px] leading-relaxed text-body">
      Three steps, without any JavaScript tooling.
    </p>
    <ol class="mb-11 flex flex-col gap-3.5 [&>li]:flex [&>li]:gap-4 [&>li>span]:flex [&>li>span]:size-[26px] [&>li>span]:flex-none [&>li>span]:items-center [&>li>span]:justify-center [&>li>span]:rounded-full [&>li>span]:bg-ember [&>li>span]:text-[13px] [&>li>span]:font-semibold [&>li>span]:text-white [&_h3]:mb-2 [&_h3]:text-sm [&_h3]:leading-[26px] [&_h3]:font-semibold">
      <li>
        <span>1</span>
        <div class="min-w-0 flex-1">
          <h3>Add the dependency</h3>
          <.code
            file="mix.exs"
            copy={~s(defp deps do\n  [\n    {:phx_icons, "~> #{phx_icons_version()}"}\n  ]\nend)}
          >
            <pre><span class="k">defp</span> <span class="nf">deps</span> <span class="k">do</span>
  [&#123;<span class="ss">:phx_icons</span>, <span class="s">"~&gt; {phx_icons_version()}"</span>&#125;]
<span class="k">end</span></pre>
          </.code>
        </div>
      </li>
      <li>
        <span>2</span>
        <div class="min-w-0 flex-1">
          <h3>Pick your providers</h3>
          <.code
            file="config.exs"
            copy={
              ~s(config :phx_icons,\n  providers: %{\n    "heroicons" => {PhxIcons.Providers.Heroicons, "#{version("heroicons")}"},\n    "lucide" => {PhxIcons.Providers.Lucide, "#{version("lucide")}"}\n  })
            }
          >
            <pre><span class="nf">config</span> <span class="ss">:phx_icons</span>,
  <span class="nf">providers:</span> %&#123;
    <span class="s">"heroicons"</span> =&gt; &#123;PhxIcons.Providers.Heroicons, <span class="s">"{version("heroicons")}"</span>&#125;,
    <span class="s">"lucide"</span> =&gt; &#123;PhxIcons.Providers.Lucide, <span class="s">"{version("lucide")}"</span>&#125;
  &#125;</pre>
          </.code>
        </div>
      </li>
      <li>
        <span>3</span>
        <div class="min-w-0 flex-1">
          <h3>Hook it into your components</h3>
          <.code
            file="core_components.ex"
            copy="defmodule MyAppWeb.CoreComponents do\n  use Phoenix.Component\n  use PhxIcons\nend"
          >
            <pre><span class="k">defmodule</span> <span class="nf">MyAppWeb.CoreComponents</span> <span class="k">do</span>
  <span class="k">use</span> Phoenix.Component
  <span class="k">use</span> PhxIcons
<span class="k">end</span></pre>
          </.code>
        </div>
      </li>
    </ol>

    <h2 id="providers" class="mt-[66px] mb-1.5 scroll-mt-20 font-serif text-[26px] font-semibold">
      Providers
    </h2>
    <p class="mb-6 text-[14.5px] leading-relaxed text-body">
      Prefix the icon name with the provider.
    </p>

    <.provider
      id="p-heroicons"
      name="Heroicons"
      prefix="heroicons"
      url="https://heroicons.com"
      version={"v#{version("heroicons")}"}
    >
      <:description>Hand-crafted icons by the makers of Tailwind CSS.</:description>
      <div class="mb-3 flex gap-1.5">
        <.pill group="hero" value="outline" checked>Outline</.pill>
        <.pill group="hero" value="mini">Mini</.pill>
      </div>
      <div class="group-has-[[value=mini]:checked]:hidden">
        <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <.tile label="heart"><.icon name="heroicons:heart" class="size-6" /></.tile>
          <.tile label="bell"><.icon name="heroicons:bell" class="size-6" /></.tile>
          <.tile label="check"><.icon name="heroicons:check" class="size-6" /></.tile>
          <.tile label="arrow-left"><.icon name="heroicons:arrow-left" class="size-6" /></.tile>
        </div>
        <.snippet name="heroicons:heart" class="size-6" />
      </div>
      <div class="hidden group-has-[[value=mini]:checked]:block">
        <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <.tile label="heart"><.icon name="heroicons-mini:heart" class="size-5" /></.tile>
          <.tile label="bell"><.icon name="heroicons-mini:bell" class="size-5" /></.tile>
          <.tile label="check"><.icon name="heroicons-mini:check" class="size-5" /></.tile>
          <.tile label="arrow-left">
            <.icon name="heroicons-mini:arrow-left" class="size-5" />
          </.tile>
        </div>
        <.snippet name="heroicons-mini:heart" class="size-5" />
      </div>
    </.provider>

    <.provider
      id="p-lucide"
      name="Lucide"
      prefix="lucide"
      url="https://lucide.dev"
      version={"v#{version("lucide")}"}
    >
      <:description>
        A community fork of Feather with clean, consistent strokes.
      </:description>
      <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
        <.tile label="heart"><.icon name="lucide:heart" class="size-6" /></.tile>
        <.tile label="bell"><.icon name="lucide:bell" class="size-6" /></.tile>
        <.tile label="check"><.icon name="lucide:check" class="size-6" /></.tile>
        <.tile label="arrow-left"><.icon name="lucide:arrow-left" class="size-6" /></.tile>
      </div>
      <.snippet name="lucide:heart" class="size-6" />
    </.provider>

    <.provider
      id="p-tabler"
      name="Tabler"
      prefix="tabler"
      url="https://tabler.io/icons"
      version={"v#{version("tabler")}"}
    >
      <:description>Over 5,000 free icons with outline and filled styles.</:description>
      <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
        <.tile label="star"><.icon name="tabler:star" class="size-6" /></.tile>
        <.tile label="bell"><.icon name="tabler:bell" class="size-6" /></.tile>
        <.tile label="check"><.icon name="tabler:check" class="size-6" /></.tile>
        <.tile label="bolt"><.icon name="tabler:bolt" class="size-6" /></.tile>
      </div>
      <.snippet name="tabler:star" class="size-6" />
    </.provider>

    <.provider
      id="p-phosphor"
      name="Phosphor"
      prefix="phosphor"
      url="https://phosphoricons.com"
      version={"v#{version("phosphor")}"}
    >
      <:description>
        Six weights: thin, light, regular, bold, fill, and duotone.
      </:description>
      <div class="mb-3 flex gap-1.5">
        <.pill group="phos" value="regular" checked>Regular</.pill>
        <.pill group="phos" value="duotone">Duotone</.pill>
      </div>
      <div class="group-has-[[value=duotone]:checked]:hidden">
        <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <.tile label="heart"><.icon name="phosphor:heart" class="size-6" /></.tile>
          <.tile label="bell"><.icon name="phosphor:bell" class="size-6" /></.tile>
          <.tile label="check"><.icon name="phosphor:check" class="size-6" /></.tile>
          <.tile label="arrow-left"><.icon name="phosphor:arrow-left" class="size-6" /></.tile>
        </div>
        <.snippet name="phosphor:heart" class="size-6" />
      </div>
      <div class="hidden group-has-[[value=duotone]:checked]:block">
        <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <.tile label="heart-duotone">
            <.icon name="phosphor:heart-duotone" class="size-6" />
          </.tile>
          <.tile label="bell-duotone">
            <.icon name="phosphor:bell-duotone" class="size-6" />
          </.tile>
          <.tile label="check-duotone">
            <.icon name="phosphor:check-duotone" class="size-6" />
          </.tile>
          <.tile label="arrow-left-duotone">
            <.icon name="phosphor:arrow-left-duotone" class="size-6" />
          </.tile>
        </div>
        <.snippet name="phosphor:heart-duotone" class="size-6" />
      </div>
    </.provider>

    <.provider
      id="p-simple"
      name="Simple Icons"
      prefix="simple-icons"
      url="https://simpleicons.org"
      version={"v#{version("simple-icons")}"}
    >
      <:description>
        Brand logos. Add
        <code class="rounded bg-sand px-1.5 py-px font-mono text-xs font-medium">
          fill-current
        </code>
        because they are filled shapes.
      </:description>
      <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
        <.tile label="github">
          <.icon name="simple-icons:github" class="size-6 fill-current" />
        </.tile>
        <.tile label="elixir">
          <.icon name="simple-icons:elixir" class="size-6 fill-current" />
        </.tile>
        <.tile label="docker">
          <.icon name="simple-icons:docker" class="size-6 fill-current" />
        </.tile>
        <.tile label="tailwindcss">
          <.icon name="simple-icons:tailwindcss" class="size-6 fill-current" />
        </.tile>
      </div>
      <.snippet name="simple-icons:github" class="size-6 fill-current" />
    </.provider>

    <.provider
      id="p-flagpack"
      name="Flagpack"
      prefix="flagpack"
      url="https://flagpack.xyz"
      version={"v#{version("flagpack")}"}
    >
      <:description>
        Country flags. You can alias names, e.g. <code class="rounded bg-sand px-1.5 py-px font-mono text-xs font-medium">"gb" =&gt; "gb-ukm"</code>.
      </:description>
      <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
        <.tile label="de" tint={false}><.icon name="flagpack:de" class="h-6 w-auto" /></.tile>
        <.tile label="at" tint={false}><.icon name="flagpack:at" class="h-6 w-auto" /></.tile>
        <.tile label="gb" tint={false}><.icon name="flagpack:gb" class="h-6 w-auto" /></.tile>
        <.tile label="us" tint={false}><.icon name="flagpack:us" class="h-6 w-auto" /></.tile>
      </div>
      <.snippet name="flagpack:de" class="h-6 w-auto" />
    </.provider>

    <.provider
      id="p-reicon"
      name="Reicon"
      prefix="reicon"
      url="https://reicon.dev"
      version={"#{version("reicon")}"}
    >
      <:description>One icon set in outline and filled styles.</:description>
      <div class="mb-3 flex gap-1.5">
        <.pill group="rei" value="outline" checked>Outline</.pill>
        <.pill group="rei" value="filled">Filled</.pill>
      </div>
      <div class="group-has-[[value=filled]:checked]:hidden">
        <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <.tile label="heart"><.icon name="reicon:heart" class="size-6" /></.tile>
          <.tile label="bell"><.icon name="reicon:bell" class="size-6" /></.tile>
          <.tile label="check"><.icon name="reicon:check" class="size-6" /></.tile>
          <.tile label="arrow-left"><.icon name="reicon:arrow-left" class="size-6" /></.tile>
        </div>
        <.snippet name="reicon:heart" class="size-6" />
      </div>
      <div class="hidden group-has-[[value=filled]:checked]:block">
        <div class="mb-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <.tile label="heart"><.icon name="reicon-filled:heart" class="size-6" /></.tile>
          <.tile label="bell"><.icon name="reicon-filled:bell" class="size-6" /></.tile>
          <.tile label="check"><.icon name="reicon-filled:check" class="size-6" /></.tile>
          <.tile label="arrow-left">
            <.icon name="reicon-filled:arrow-left" class="size-6" />
          </.tile>
        </div>
        <.snippet name="reicon-filled:heart" class="size-6" />
      </div>
    </.provider>

    <h2 id="sizing" class="mt-[66px] mb-1.5 scroll-mt-20 font-serif text-[26px] font-semibold">
      Sizing &amp; color
    </h2>
    <p class="mb-3.5 text-[14.5px] leading-relaxed text-body">
      Icons inherit <code class="rounded bg-sand px-1.5 py-px font-mono text-xs font-medium">currentColor</code>,
      so you size and tint them with plain Tailwind utilities.
    </p>
    <div class="mb-3.5 overflow-hidden rounded-[14px] border border-line bg-white">
      <div class="flex items-end justify-center gap-10 bg-[repeating-linear-gradient(45deg,#FCFAF6_0_10px,#FAF7F2_10px_20px)] p-[30px] [&>div]:flex [&>div]:flex-col [&>div]:items-center [&>div]:gap-2 [&_span]:font-mono [&_span]:text-[10.5px] [&_span]:font-medium [&_span]:text-faint">
        <div><.icon name="lucide:heart" class="size-4" /><span>size-4</span></div>
        <div><.icon name="lucide:heart" class="size-6" /><span>size-6</span></div>
        <div><.icon name="lucide:heart" class="size-8" /><span>size-8</span></div>
        <div><.icon name="lucide:heart" class="size-12" /><span>size-12</span></div>
      </div>
      <div class="flex items-center justify-center gap-10 border-t border-sand px-[30px] py-[26px]">
        <.icon name="lucide:heart" class="size-8 text-red-600" />
        <.icon name="lucide:star" class="size-8 text-yellow-600" />
        <.icon name="lucide:zap" class="size-8 text-green-600" />
        <.icon name="lucide:bell" class="size-8 text-purple-600" />
      </div>
    </div>
    <.snippet name="heroicons:heart" class="size-8 text-red-500" />

    <h2 id="animations" class="mt-[66px] mb-1.5 scroll-mt-20 font-serif text-[26px] font-semibold">
      Animations
    </h2>
    <p class="mb-3.5 text-[14.5px] leading-relaxed text-body">
      Because the SVG is inlined, Tailwind's transition and animation utilities apply to it directly.
    </p>
    <div class="mb-3.5 flex flex-wrap gap-2 [&>div]:flex [&>div]:min-w-[130px] [&>div]:flex-1 [&>div]:flex-col [&>div]:items-center [&>div]:gap-[11px] [&>div]:rounded-[10px] [&>div]:border [&>div]:border-line [&>div]:bg-white [&>div]:px-2 [&>div]:pt-[22px] [&>div]:pb-3.5 [&_span]:font-mono [&_span]:text-[10.5px] [&_span]:font-medium [&_span]:text-faint">
      <div class="group">
        <.icon
          name="lucide:heart"
          class="size-[30px] transition-all group-hover:scale-125 group-hover:text-red-600"
        />
        <span>scale + color</span>
      </div>
      <div class="group">
        <.icon name="lucide:bell" class="size-[30px] motion-safe:group-hover:animate-ping" />
        <span>animate-ping</span>
      </div>
      <div class="group">
        <.icon
          name="lucide:star"
          class="size-[30px] group-hover:text-yellow-600 motion-safe:group-hover:animate-spin"
        />
        <span>animate-spin</span>
      </div>
      <div class="group">
        <.icon
          name="lucide:arrow-left"
          class="size-[30px] group-hover:text-blue-600 motion-safe:group-hover:animate-pulse"
        />
        <span>animate-pulse</span>
      </div>
    </div>
    <div class="mb-0">
      <.snippet
        name="heroicons:heart"
        class="size-8 hover:text-red-500 hover:scale-125 transition-all"
      />
    </div>

    <h2 id="download" class="mt-[66px] mb-1.5 scroll-mt-20 font-serif text-[26px] font-semibold">
      Pre-downloading icons
    </h2>
    <p class="mb-3.5 text-[14.5px] leading-relaxed text-body">
      You can also pre-download all icons from a provider, a specific list, or extra icons in
      addition to the icons discovered in your codebase.
    </p>
    <.code
      file="config.exs"
      copy={
        ~s|config :phx_icons,\n  providers: %{\n    # Download all icons upfront\n    "heroicons" => {PhxIcons.Providers.Heroicons, "#{version("heroicons")}", download: :all},\n    # Download a specific set\n    "lucide" => {PhxIcons.Providers.Lucide, "#{version("lucide")}", download: ~w(search check x)},\n    # Download discovered icons plus these extra icons\n    "tabler" => {PhxIcons.Providers.Tabler, "#{version("tabler")}", download: {:also, ~w(settings user)}}\n  }|
      }
    >
      <pre><span class="nf">config</span> <span class="ss">:phx_icons</span>,
  <span class="nf">providers:</span> %&#123;
    <span class="c"># Download all icons upfront</span>
    <span class="s">"heroicons"</span> =&gt; &#123;PhxIcons.Providers.Heroicons, <span class="s">"{version("heroicons")}"</span>, <span class="nf">download:</span> <span class="ss">:all</span>&#125;,
    <span class="c"># Download a specific set</span>
    <span class="s">"lucide"</span> =&gt; &#123;PhxIcons.Providers.Lucide, <span class="s">"{version("lucide")}"</span>, <span class="nf">download:</span> <span class="s">~w(search check x)</span>&#125;,
    <span class="c"># Download discovered icons plus these extra icons</span>
    <span class="s">"tabler"</span> =&gt; &#123;PhxIcons.Providers.Tabler, <span class="s">"{version("tabler")}"</span>, <span class="nf">download:</span> &#123;<span class="ss">:also</span>, <span class="s">~w(settings user)</span>&#125;&#125;
  &#125;</pre>
    </.code>

    <h2 id="custom" class="mt-[66px] mb-1.5 scroll-mt-20 font-serif text-[26px] font-semibold">
      Custom providers
    </h2>
    <p class="mb-3.5 text-[14.5px] leading-relaxed text-body">
      Implement the
      <code class="rounded bg-sand px-1.5 py-px font-mono text-xs font-medium">
        PhxIcons.Provider
      </code>
      behaviour.
    </p>
    <div class="mb-3.5">
      <.code
        file="custom_icons.ex"
        copy={
          ~s|defmodule MyApp.Providers.CustomIcons do\n  @behaviour PhxIcons.Provider\n\n  @impl true\n  def release_url(version) do\n    "https://github.com/org/repo/archive/refs/tags/v\#{version}.zip"\n  end\n\n  @impl true\n  def svg_path(version, icon_name, _opts) do\n    "repo-\#{version}/icons/\#{icon_name}.svg"\n  end\nend|
        }
      >
        <pre><span class="k">defmodule</span> <span class="nf">MyApp.Providers.CustomIcons</span> <span class="k">do</span>
  <span class="ss">@behaviour</span> PhxIcons.Provider

  <span class="ss">@impl</span> <span class="k">true</span>
  <span class="k">def</span> <span class="nf">release_url</span>(version) <span class="k">do</span>
    <span class="s">"https://github.com/org/repo/archive/refs/tags/v#&#123;version&#125;.zip"</span>
  <span class="k">end</span>

  <span class="ss">@impl</span> <span class="k">true</span>
  <span class="k">def</span> <span class="nf">svg_path</span>(version, icon_name, _opts) <span class="k">do</span>
    <span class="s">"repo-#&#123;version&#125;/icons/#&#123;icon_name&#125;.svg"</span>
  <span class="k">end</span>
<span class="k">end</span></pre>
      </.code>
    </div>
    <p class="mb-3.5 text-[14.5px] leading-relaxed text-body">
      Optionally implement
      <code class="rounded bg-sand px-1.5 py-px font-mono text-xs font-medium">transform/1</code>
      to rewrite each SVG before it's stored, e.g. replacing hardcoded fills with <code class="rounded bg-sand px-1.5 py-px font-mono text-xs font-medium">currentColor</code>. This is how the built-in Reicon provider does it:
    </p>
    <div class="mb-3.5">
      <.code
        file="custom_icons.ex"
        copy={
          ~s|@impl true\ndef transform(svg) do\n  String.replace(svg, ~s(fill="#000000"), ~s(fill="currentColor"))\nend|
        }
      >
        <pre><span class="ss">@impl</span> <span class="k">true</span>
<span class="k">def</span> <span class="nf">transform</span>(svg) <span class="k">do</span>
  String.replace(svg, <span class="s">~s(fill="#000000")</span>, <span class="s">~s(fill="currentColor")</span>)
<span class="k">end</span></pre>
      </.code>
    </div>
    <p class="mb-3.5 text-[14.5px] leading-relaxed text-body">
      Then register it in your config.
    </p>
    <.code
      file="config.exs"
      copy={
        ~s|config :phx_icons,\n  providers: %{\n    "custom" => {MyApp.Providers.CustomIcons, "1.0.0"}\n  }|
      }
    >
      <pre><span class="nf">config</span> <span class="ss">:phx_icons</span>,
  <span class="nf">providers:</span> %&#123;
    <span class="s">"custom"</span> =&gt; &#123;MyApp.Providers.CustomIcons, <span class="s">"1.0.0"</span>&#125;
  &#125;</pre>
    </.code>

    <h2 id="testing" class="mt-[66px] mb-1.5 scroll-mt-20 font-serif text-[26px] font-semibold">
      Testing
    </h2>
    <p class="mb-3.5 text-[14.5px] leading-relaxed text-body">
      PhxIcons ships with test helpers to assert icons are rendered.
    </p>
    <div class="mb-14">
      <.code
        file="core_components_test.exs"
        copy={
          ~s|import PhxIcons.Test\n\nhtml = render_component(&MyAppWeb.CoreComponents.icon/1, name: "heroicons:heart")\nassert_icon(html, "heroicons:heart")\nrefute_icon(html, "heroicons:x-mark")|
        }
      >
        <pre><span class="k">import</span> PhxIcons.Test

html = <span class="nf">render_component</span>(&amp;MyAppWeb.CoreComponents.icon/1, <span class="nf">name:</span> <span class="s">"heroicons:heart"</span>)
<span class="nf">assert_icon</span>(html, <span class="s">"heroicons:heart"</span>)
<span class="nf">refute_icon</span>(html, <span class="s">"heroicons:x-mark"</span>)</pre>
      </.code>
    </div>
  </main>

